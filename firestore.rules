rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kullanıcılar sadece kendi verilerini okuyabilir/yazabilir
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Sunucular - üyelik kontrolü
    match /servers/{serverId} {
      allow read: if request.auth != null && isServerMember(serverId, request.auth.uid);
      allow write: if request.auth != null && isServerOwner(serverId, request.auth.uid);
    }
    
    // Kanallar - sunucu üyeliği gerekli
    match /channels/{channelId} {
      allow read: if request.auth != null && isServerMember(resource.data.serverId, request.auth.uid);
      allow write: if request.auth != null && isServerMember(resource.data.serverId, request.auth.uid);
    }
    
    // Mesajlar - sunucu üyeliği ve mesaj gönderme izni
    match /messages/{messageId} {
      allow read: if request.auth != null && isServerMember(resource.data.serverId, request.auth.uid);
      allow create: if request.auth != null && 
        request.auth.uid == resource.data.authorId &&
        isServerMember(resource.data.serverId, request.auth.uid);
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.authorId;
    }
    
    // Sunucu üyelikleri
    match /serverMembers/{membershipId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Roller - sunucu üyeliği gerekli
    match /roles/{roleId} {
      allow read: if request.auth != null && isServerMember(resource.data.serverId, request.auth.uid);
      allow write: if request.auth != null && isServerMember(resource.data.serverId, request.auth.uid);
    }
    
    // Odalar - sunucu üyeliği gerekli
    match /rooms/{roomId} {
      allow read: if request.auth != null && isServerMember(resource.data.serverId, request.auth.uid);
      allow write: if request.auth != null && isServerMember(resource.data.serverId, request.auth.uid);
    }
    
    // Arkadaşlıklar
    match /friendships/{friendshipId} {
      allow read, write: if request.auth != null && 
        (resource.data.userId1 == request.auth.uid || resource.data.userId2 == request.auth.uid);
    }
    
    // Özel mesajlar
    match /directMessages/{dmId} {
      allow read, write: if request.auth != null && 
        request.auth.uid in resource.data.participants;
    }
    
    // DM mesajları
    match /dmMessages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == resource.data.authorId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }
    
    // Bildirimler
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Yardımcı fonksiyonlar
    function isServerMember(serverId, userId) {
      return exists(/databases/$(database)/documents/serverMembers/$(serverId + '_' + userId));
    }
    
    function isServerOwner(serverId, userId) {
      return get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId == userId;
    }
  }
} 